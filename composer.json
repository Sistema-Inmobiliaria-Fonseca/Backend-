{
    "name": "inmobiliaria/backend",
    "description": "API REST del sistema para una inmobiliaria (PHP 8.3 + MySQL + PDO)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t web bootstrap/front.php",
        "lint": "@php -l bootstrap/app.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
