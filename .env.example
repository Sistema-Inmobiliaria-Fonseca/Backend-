APP_NAME="Inmobiliaria API"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Firma de los tokens de sesion del panel. Generala con:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
AUTH_TOKEN_SECRET=
# Vida del token en segundos (43200 = 12 horas).
AUTH_TOKEN_TTL=43200

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inmobiliaria
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=false

# Imagenes de propiedades. UPLOAD_MAX_BYTES=0 usa upload_max_filesize/post_max_size de PHP.
# UPLOAD_PATH=/ruta/absoluta/storage/uploads/propiedades
UPLOAD_MAX_IMAGES=12
UPLOAD_MAX_BYTES=0
UPLOAD_CACHE_MAX_AGE=604800
